{
  "manifest_version": 3,
  "name": "SCViz",
  "version": "1.4.0",
  "description": "A visualizer / playing mode for SoundCloud. Toggle from the player bar, keep the waveform, show or hide comments.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle SoundCloud visualizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabCapture", "storage"],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://*.sndcdn.com/*",
    "https://*.soundcloud.cloud/*",
    "https://graph.soundcloud.com/*"
  ],
  "commands": {
    "toggle-visualizer": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Toggle SoundCloud visualizer"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"],
      "js": ["src/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"],
      "js": [
        "src/vendor/three.min.js",
        "src/magnetosphere-post.js",
        "src/visualizer.js",
        "src/content.js"
      ],
      "css": ["src/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"],
      "js": ["src/frame.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
